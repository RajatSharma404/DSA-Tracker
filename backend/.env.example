# Backend Environment Variables Template
# Copy this file to backend/.env and fill in your actual values

NODE_ENV=production
PORT=8080

# Database Configuration (use Cloud SQL connection string for production)
# Format: postgresql://user:password@host/database?schema=public
# For Cloud SQL: postgresql://user:password@/database?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DATABASE_URL="postgresql://dsauser:YOUR_PASSWORD_HERE@/dsatracker?host=/cloudsql/PROJECT_ID:REGION:dsa-postgres-prod"

# Authentication Secret (generate with: openssl rand -base64 48)
BACKEND_JWT_SECRET="your-32-byte-minimum-backend-jwt-secret-here"
AUTH_ACCEPT_LEGACY="false"
NEXTAUTH_SECRET="your-secret-key-here"
# Optional fallback name used by some auth libs
AUTH_SECRET="your-secret-key-here"

# Security & Feature Flags
EXTENSION_LEGACY_SYNC="false"
LEETCODE_SERVER_SUBMIT="false"
CODE_EXEC_ENABLED="false"
COOKIE_ENCRYPTION_KEY="your-32-byte-encryption-key-here"

# Optional Upstash Redis for distributed rate-limiting and shared caching
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Google AI / Gemini API Key & Model (Official Flash standard: gemini-2.5-flash)
# Reference: https://ai.google.dev/gemini-api/docs/models/gemini
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Per-User Daily AI Quotas
AI_DAILY_LIMIT_HINTS=30
AI_DAILY_LIMIT_REVIEW=15
AI_DAILY_LIMIT_PLAN=3
AI_DAILY_LIMIT_EXPLAIN=10
AI_DAILY_LIMIT_PATTERNS=10
AI_DAILY_LIMIT_TRACE=20

# NextAuth Configuration
NEXTAUTH_URL="https://yourdomain.com"

# Admin Email (optional - gets auto-promoted to admin)
ADMIN_EMAIL="rajat.sharma.myid1@gmail.com"

# Comma-separated allowlist for browser origins (recommended in production)
# Example: CORS_ORIGINS="https://app.example.com,http://localhost:3000"
CORS_ORIGINS=""

# Legacy dev-only email login switch (highly insecure, keep false in production)
ALLOW_INSECURE_CREDENTIALS_LOGIN="false"

# Phase 5 Feature Flags (Single Source of Truth)
# Runtime feature flags parsed by backend/features.ts
# Must be 'true' or 'false'. Parked features default to false; showpiece defaults to true.
FEATURE_PVP="false"
FEATURE_ARENA="false"
FEATURE_INTERVIEWS="false"
FEATURE_ALGOTRACER="true"
