# Backend Environment Variables Template
# Copy this file to backend/.env and fill in your actual values

NODE_ENV=production
PORT=8080

# Database Configuration (use Cloud SQL connection string for production)
# Format: postgresql://user:password@host/database?schema=public
# For Cloud SQL: postgresql://user:password@/database?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DATABASE_URL="postgresql://dsauser:YOUR_PASSWORD_HERE@/dsatracker?host=/cloudsql/PROJECT_ID:REGION:dsa-postgres-prod"

# Authentication Secret (generate with: openssl rand -base64 48)
NEXTAUTH_SECRET="your-secret-key-here"

# Google AI / Gemini API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# NextAuth Configuration
NEXTAUTH_URL="https://yourdomain.com"

# Admin Email (optional - gets auto-promoted to admin)
ADMIN_EMAIL="rajat.sharma.myid1@gmail.com"
