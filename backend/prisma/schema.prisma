generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  name             String?
  emailVerified    DateTime?       @map("email_verified")
  image            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  role             Role            @default(USER)
  leetcodeUsername String?
  leetcodeSession  String?
  mockInterviews   MockInterview[]
  progress         Progress[]
  streak           Streak?
  accounts         Account[]
  sessions         Session[]
  challengeSessions ChallengeSession[]
  notes            ProblemNote[]
  solutions        SolutionHistory[]
  bookmarks        Bookmark[]
  tags             UserTag[]
  theoryLessonProgress UserTheoryLessonProgress[]
}

model Topic {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  orderIndex  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  problems    Problem[]
  theoryModules TheoryModule[]
}

model ChallengeSession {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemIds  String[]
  startTime   DateTime       @default(now())
  endTime     DateTime?
  duration    Int
  status      ChallengeStatus @default(IN_PROGRESS)
  createdAt   DateTime       @default(now())
}

enum ChallengeStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Problem {
  id         String     @id @default(uuid())
  title      String
  link       String?
  difficulty Difficulty @default(EASY)
  topicId    String
  orderIndex Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress   Progress[]
  notes      ProblemNote[]
  solutions  SolutionHistory[]
  bookmarks  Bookmark[]
  problemTags ProblemTag[]
  theoryProblemLinks TheoryProblemLink[]
}

model ProblemNote {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  content   String
  type      NoteType @default(LEARNING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
  @@map("problem_notes")
}

enum NoteType {
  GOTCHA
  LEARNING
  TIP
}


model Progress {
  id             String         @id @default(uuid())
  userId         String
  problemId      String
  status         ProgressStatus @default(TODO)
  timeSpent      Int            @default(0)
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  easinessFactor Float          @default(2.5)
  interval       Int            @default(0)
  nextReviewDate DateTime?
  leetcodeRuntime String?
  leetcodeMemory  String?
  problem        Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model Streak {
  id               String   @id @default(uuid())
  userId           String   @unique
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActivityDate DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MockInterview {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  score     Int?
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgressStatus {
  TODO
  DOING
  DONE
}

enum Role {
  USER
  ADMIN
}

// === New Feature Models ===

model SolutionHistory {
  id          String   @id @default(uuid())
  userId      String
  problemId   String
  code        String
  language    String
  isCorrect   Boolean  @default(false)
  score       Int      @default(0)
  verdict     String?
  timeComplexity  String?
  spaceComplexity String?
  isOptimal   Boolean  @default(false)
  isAIGenerated String @default("UNKNOWN") // HUMAN, AI_GENERATED, AI_ASSISTED, TEMPLATE, UNKNOWN
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
  @@map("solution_history")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@map("bookmarks")
}

model UserTag {
  id        String       @id @default(uuid())
  userId    String
  name      String
  color     String       @default("#6366f1")
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problems  ProblemTag[]

  @@unique([userId, name])
  @@map("user_tags")
}

model ProblemTag {
  id        String   @id @default(uuid())
  problemId String
  tagId     String
  createdAt DateTime @default(now())
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag       UserTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([problemId, tagId])
  @@map("problem_tags")
}

model TheoryTrack {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  description String?
  orderIndex  Int           @default(0)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  modules     TheoryModule[]

  @@map("theory_tracks")
}

model TheoryModule {
  id               String            @id @default(uuid())
  trackId          String
  topicId          String?
  slug             String
  title            String
  summary          String?
  orderIndex       Int               @default(0)
  estimatedMinutes Int               @default(0)
  isPublished      Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  track            TheoryTrack       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  topic            Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  lessons          TheoryLesson[]
  problemLinks     TheoryProblemLink[]

  @@unique([trackId, slug])
  @@index([topicId])
  @@map("theory_modules")
}

model TheoryLesson {
  id                 String                    @id @default(uuid())
  moduleId           String
  slug               String
  title              String
  summary            String?
  orderIndex         Int                       @default(0)
  difficulty         TheoryDifficulty          @default(BEGINNER)
  estimatedMinutes   Int                       @default(0)
  learningObjectives Json?
  isPublished        Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  module             TheoryModule              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  blocks             TheoryLessonBlock[]
  problemLinks       TheoryProblemLink[]
  progress           UserTheoryLessonProgress[]

  @@unique([moduleId, slug])
  @@map("theory_lessons")
}

model TheoryLessonBlock {
  id         String          @id @default(uuid())
  lessonId   String
  blockType  TheoryBlockType
  orderIndex Int
  content    Json
  language   String?
  lesson     TheoryLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, orderIndex])
  @@map("theory_lesson_blocks")
}

model TheoryProblemLink {
  id         String       @id @default(uuid())
  lessonId   String?
  moduleId   String?
  problemId  String
  required   Boolean      @default(true)
  orderIndex Int          @default(0)
  lesson     TheoryLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module     TheoryModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  problem    Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([moduleId])
  @@index([problemId])
  @@map("theory_problem_links")
}

model UserTheoryLessonProgress {
  userId           String
  lessonId         String
  status           TheoryProgressStatus @default(NOT_STARTED)
  progressPercent  Int                  @default(0)
  timeSpentSeconds Int                  @default(0)
  completedAt      DateTime?
  lastSeenBlockId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson           TheoryLesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("user_theory_lesson_progress")
}

enum TheoryDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TheoryBlockType {
  MARKDOWN
  CODE
  NOTE
  QUIZ
  IMAGE
}

enum TheoryProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
