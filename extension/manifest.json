{
  "manifest_version": 3,
  "name": "DSA Pro Live Sync",
  "version": "1.0",
  "description": "Automatically pings DSA Tracker Pro when you get an 'Accepted' submission on LeetCode.",
  "permissions": ["cookies", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
